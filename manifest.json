{
  "manifest_version": 3,
  "name": "Nodea Tree for Claude",
  "version": "0.2.0",
  "description": "Surfaces the hidden branch tree inside Claude as a Nodea-style conversation map. Visualize, then open the whole tree in Nodea.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://nodea.ai/*",
    "https://www.nodea.ai/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Nodea Tree",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/util.js",
        "src/adapters/claude.js",
        "src/adapters/claude-write.js",
        "src/tree.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/theme.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nodea.ai/*",
        "https://www.nodea.ai/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
