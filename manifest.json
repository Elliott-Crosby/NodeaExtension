{
  "manifest_version": 3,
  "name": "Nodea Tree for Claude — Branch Map for claude.ai",
  "version": "0.2.1",
  "description": "For claude.ai only. Surfaces Claude's hidden branch tree as a visual conversation map. Open the full tree in Nodea.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://nodea.ai/*",
    "https://www.nodea.ai/*",
    "https://kzqhpygdhphjaiymqcmq.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Nodea Tree",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/util.js",
        "src/auth.js",
        "src/adapters/claude.js",
        "src/adapters/claude-write.js",
        "src/tree.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/theme.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nodea.ai/*",
        "https://www.nodea.ai/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
